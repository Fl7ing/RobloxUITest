                if IsValidPos(v.Position) then
                    SC(function() hrp.CFrame = v.CFrame + Vector3.new(0,2,0) end)
                end
                break
            end
        end
    end
end

            if S.AutoKnife then
                local k = LP.Backpack:FindFirstChild("Knife")
                if k then SC(function() hum:EquipTool(k) end) end
            end

            if S.KillAura then
                local knife = char:FindFirstChild("Knife")
                if knife and knife:FindFirstChild("Handle") then
                    for _, p in pairs(PL:GetPlayers()) do
                        if p ~= LP and p.Character then
                            local r = p.Character:FindFirstChild("HumanoidRootPart")
                            if r and (hrp.Position - r.Position).Magnitude <= S.KillAuraRange then
                                SC(function() firetouchinterest(r, knife.Handle, 0); firetouchinterest(r, knife.Handle, 1) end)
                                if S.HitSound then SC(function() hitSound:Play() end) end
                                if S.MultiAura then task.wait(S.MultiAuraDelay) end
                            end
                        end
                    end
                end
            end

            if S.KnifeTP then
                local knife = char:FindFirstChild("Knife")
                if knife then
                    local t = GetClosest(false)
                    if t and t.Character then
                        local r = t.Character:FindFirstChild("HumanoidRootPart")
                        if r then
                            local dist = (hrp.Position - r.Position).Magnitude
                            if dist < S.KnifeTeleportRange then
                                local dir    = (r.Position - hrp.Position).Unit
                                local newPos = r.Position - dir * 4
                                if IsValidPos(newPos) then
                                    SC(function() hrp.CFrame = CFrame.new(newPos) end)
                                end
                            end
                        end
                    end
                end
            end

            if S.AutoThrow then
                local knife = char:FindFirstChild("Knife")
                if knife then
                    local t = GetClosest(false)
                    if t and t.Character then
                        local r = t.Character:FindFirstChild("HumanoidRootPart")
                        if r then
                            local pos = r.Position
                            if S.PredictionAim and PlayerVelocity[t] then
                                pos = pos + PlayerVelocity[t] * S.PredictionAmount
                            end
                            local rem = knife:FindFirstChild("KnifeServer") or knife:FindFirstChildWhichIsA("RemoteFunction")
                            if rem then SC(function() rem:InvokeServer(pos) end) end
                        end
                    end
                end
            end

            if S.SafeShoot then
                local gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
                         or LP.Backpack:FindFirstChild("Gun") or LP.Backpack:FindFirstChild("Revolver")
                if gun then
                    if gun.Parent == LP.Backpack then SC(function() hum:EquipTool(gun) end) end
                    for _, p in pairs(PL:GetPlayers()) do
                        if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                            local mRoot = p.Character:FindFirstChild("HumanoidRootPart")
                            if mRoot and CanSee(mRoot) then
                                local pos = mRoot.Position
                                if S.PredictionAim and PlayerVelocity[p] then
                                    pos = pos + PlayerVelocity[p] * S.PredictionAmount
                                end
                                local rem = gun:FindFirstChild("ShootGun") or gun:FindFirstChild("Shoot")
                                         or gun:FindFirstChildWhichIsA("RemoteEvent")
                                if rem then
                                    if S.ChamberShot then
                                        for _ = 1, S.ChamberCount do
                                            SC(function() rem:FireServer(pos) end); task.wait(0.05)
                                        end
                                    else
                                        SC(function() rem:FireServer(pos) end)
                                    end
                                    if S.HitSound then SC(function() hitSound:Play() end) end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

