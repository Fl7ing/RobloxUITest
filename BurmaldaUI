-- NOCLIP (переработан — более стабильный)
-- ──────────────────────────────────────────────
local noclipConn   = nil
local noclipActive = false
local noclipParts  = {} -- сохраняем оригинальные значения

local function EnableNoclip()
    if noclipActive then return end
    noclipActive = true
    noclipParts = {}

    noclipConn = RS.Stepped:Connect(function()
        if not S.Noclip then
            -- Восстанавливаем коллизии
            for part, val in pairs(noclipParts) do
                SC(function()
                    if part and part.Parent then
                        part.CanCollide = val
                    end
                end)
            end
            noclipParts = {}
            if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
            noclipActive = false
            return
        end

        local _, ch = GetHRP()
        if not ch then return end
        for _, p in pairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then
                if noclipParts[p] == nil then
                    noclipParts[p] = p.CanCollide
                end
                SC(function() p.CanCollide = false end)
            end
        end
    end)
end

local function DisableNoclip()
    S.Noclip = false
    -- Восстановление произойдёт в Stepped
end

-- ──────────────────────────────────────────────
-- FLY (переработан — BodyVelocity + BodyGyro подход через CFrame)
-- Использует VectorForce для поддержания высоты без телепортов
-- ──────────────────────────────────────────────
local flyConn      = nil
local flyActive    = false
local flyBodyVel   = nil
local flyBodyGyro  = nil
local flyAttach    = nil

local function CreateFlyParts(hrp)
    -- Удаляем старые если есть
    if flyBodyVel  then SC(function() flyBodyVel:Destroy()  end); flyBodyVel  = nil end
    if flyBodyGyro then SC(function() flyBodyGyro:Destroy() end); flyBodyGyro = nil end
    if flyAttach   then SC(function() flyAttach:Destroy()   end); flyAttach   = nil end

    SC(function()
        flyAttach = Instance.new("Attachment", hrp)
        flyAttach.Name = "FlyAttach"

        flyBodyVel = Instance.new("LinearVelocity", hrp)
        flyBodyVel.Attachment0 = flyAttach
        flyBodyVel.MaxForce = 1e6
        flyBodyVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        flyBodyVel.VectorVelocity = Vector3.zero
        flyBodyVel.Name = "FlyVelocity"

        flyBodyGyro = Instance.new("AlignOrientation", hrp)
        flyBodyGyro.Attachment0 = flyAttach
        flyBodyGyro.MaxTorque   = 1e5
        flyBodyGyro.Responsiveness = 50
        flyBodyGyro.Name = "FlyGyro"
    end)
end

local function DestroyFlyParts()
    SC(function() if flyBodyVel  then flyBodyVel:Destroy();  flyBodyVel  = nil end end)
    SC(function() if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end end)
    SC(function() if flyAttach   then flyAttach:Destroy();   flyAttach   = nil end end)
end

local function StartFly()
    if flyActive then return end

    local hrp, char = GetHRP()
    if not hrp or not char then return end

    flyActive = true
    CreateFlyParts(hrp)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        SC(function() hum.PlatformStand = true end)
    end

    flyConn = RS.Heartbeat:Connect(function(dt)
        if not S.Fly then
            -- Выключение
            DestroyFlyParts()
            local _, ch = GetHRP()
            if ch then
                local h = ch:FindFirstChildOfClass("Humanoid")
                if h then SC(function() h.PlatformStand = false end) end
            end
            flyConn:Disconnect()
            flyConn   = nil
            flyActive = false
            return
        end

        local fhrp, fchar = GetHRP()
        if not fhrp or not fchar then return end

        -- Пересоздаём части если исчезли (например после respawn)
        if not fhrp:FindFirstChild("FlyVelocity") then
            CreateFlyParts(fhrp)
        end
        if not flyBodyVel then return end

        local dir   = Vector3.zero
        local camCF = Cam.CFrame

        -- Направления движения
        local fwd   = Vector3.new(camCF.LookVector.X,  0, camCF.LookVector.Z).Unit
        local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd  end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end

        -- Вертикаль
        local vertDir = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space)     then vertDir =  1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertDir = -1 end

        -- Скорость с ускорением при зажатом Ctrl
        local spd = S.FlySpeed
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then spd = spd * 2.5 end

        -- Итоговая скорость
        local vel = Vector3.zero
        if dir.Magnitude > 0 then
            vel = dir.Unit * spd
        end
        vel = vel + Vector3.new(0, vertDir * spd, 0)

        SC(function()
            if flyBodyVel and flyBodyVel.Parent then
                flyBodyVel.VectorVelocity = vel
            end
        end)
    end)
end

local function StopFly()
    S.Fly = false
    -- Остальное произойдёт в flyConn
end

-- ──────────────────────────────────────────────
-- AIR WALK — движение в воздухе (новая функция)
-- Отключает гравитацию частично для плавного полёта
-- ──────────────────────────────────────────────
local airWalkConn = nil

local function StartAirWalk()
    if airWalkConn then return end
    airWalkConn = RS.Heartbeat:Connect(function(dt)
        if not S.AirWalk then
            airWalkConn:Disconnect()
            airWalkConn = nil
            return
        end
        local hrp, char = GetHRP()
        if not hrp or not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Jumping then
            SC(function()
                local vel = hrp.AssemblyLinearVelocity
                -- Замедляем падение (антигравитация 70%)
                if vel.Y < 0 then
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        vel.X,
                        vel.Y * (1 - dt * 5),
                        vel.Z
                    )
                end
            end)
        end
    end)
end

