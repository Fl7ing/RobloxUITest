                        local mRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        if mRoot then
                            local diff   = hrp.Position - mRoot.Position
                            local dist   = diff.Magnitude
                            local radius = S.DodgeRadius
                            if S.SmartDodge and PlayerVelocity[p] then
                                local approach = PlayerVelocity[p]:Dot(-diff.Unit)
                                if approach > 5 then radius = radius + approach * S.PredictionAmount * 10 end
                            end
                            if dist < radius and dist > 0 then
                                DodgeFrom(hrp, mRoot.Position, S.DodgeStrength)
                                ShowAlert(dist)
                            end
                        end
                    end
                end
            end

            if S.AutoBlock then
                for _, p in pairs(PL:GetPlayers()) do
                    if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                        local mRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        if mRoot and PlayerVelocity[p] then
                            local toMe = hrp.Position - mRoot.Position
                            local dist = toMe.Magnitude
                            local vel  = PlayerVelocity[p]
                            if dist < 18 and vel.Magnitude > 8 then
                                local perp = Vector3.new(-vel.Z, 0, vel.X).Unit
                                SC(function()
                                    hrp.AssemblyLinearVelocity = perp * 40 + Vector3.new(0, 20, 0)
                                end)
                            end
                        end
                    end
                end
            end

            if S.CounterKnife then
                for _, v in pairs(WS:GetDescendants()) do
                    if v:IsA("BasePart") and v.Name == "KnifeThrown" then
                        local dist = (hrp.Position - v.Position).Magnitude
                        if dist < 15 then
                            SC(function()
                                hrp.AssemblyLinearVelocity = (hrp.Position - v.Position).Unit * 50 + Vector3.new(0,25,0)
                            end)
                        end
                    end
                end
            end

            if S.MurderAlert and not S.KnifeDodge and not S.SmartDodge then
                for _, p in pairs(PL:GetPlayers()) do
                    if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                        local mRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        if mRoot then
                            local dist = (hrp.Position - mRoot.Position).Magnitude
                            if dist < S.AlertRadius then ShowAlert(dist) end
                        end
                    end
                end
            end

            if S.MurdererTracker and confirmedMurderer and confirmedMurderer.Character then
                local mRoot = confirmedMurderer.Character:FindFirstChild("HumanoidRootPart")
                if mRoot then
                    local dist = (hrp.Position - mRoot.Position).Magnitude
                    if dist < 18 then
                        ShowAlert(nil, "⚠ " .. confirmedMurderer.Name .. " IS CLOSE! [" .. math.floor(dist) .. "m] ⚠")
                    end
                end
            end

            if S.SafeZoneAlert then
                local mNear = false
                for _, p in pairs(PL:GetPlayers()) do
                    if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                        local r = p.Character:FindFirstChild("HumanoidRootPart")
                        if r and (hrp.Position - r.Position).Magnitude < 40 then
                            mNear = true; break
                        end
                    end
                end
                if mNear then
                    local alive = 0
                    for _, p in pairs(PL:GetPlayers()) do
                        if p.Character then
                            local h = p.Character:FindFirstChild("Humanoid")
                            if h and h.Health > 0 then alive += 1 end
                        end
                    end
                    if alive <= 3 then ShowAlert(nil, "⚠ DANGER: ONLY " .. alive .. " ALIVE! ⚠") end
                end
            end

            if S.LastStandAlert then
                local alive = 0; local myAlive = false
                for _, p in pairs(PL:GetPlayers()) do
                    if p.Character then
                        local h = p.Character:FindFirstChild("Humanoid")
                        if h and h.Health > 0 then
                            alive += 1
                            if p == LP then myAlive = true end
                        end
                    end
                end
                if myAlive and alive <= 2 then
                    ShowAlert(nil, "⚠ LAST STAND! " .. alive .. " ALIVE! ⚠")
                end
            end

            if S.AutoHide then
                for _, p in pairs(PL:GetPlayers()) do
                    if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                        local mRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        if mRoot then
                            local dist = (hrp.Position - mRoot.Position).Magnitude
                            if dist < S.HideRadius then
                                local coverDir = FindCoverDir(hrp, mRoot.Position)
                                if coverDir then
                                    local newPos = hrp.Position + coverDir * 8
                                    if IsValidPos(newPos) then
                                        SC(function() hrp.CFrame = CFrame.new(newPos) end)
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if S.SmartFollow and confirmedSheriff and confirmedSheriff ~= LP and confirmedSheriff.Character then
                local sRoot = confirmedSheriff.Character:FindFirstChild("HumanoidRootPart")
                if sRoot then
                    local dist = (hrp.Position - sRoot.Position).Magnitude
                    if dist > S.FollowDistance then
                        local dir    = (sRoot.Position - hrp.Position).Unit
                        local newPos = hrp.Position + dir * math.min(5, dist - S.FollowDistance)
                        if IsValidPos(newPos) then
                            SC(function() hrp.CFrame = CFrame.new(newPos) end)
                        end
                    end
                end
            end

 if S.GunGrab then
    -- Не работает если ты мёрдерер (нож есть в character или backpack)
    local isMurderer = char:FindFirstChild("Knife") ~= nil
                    or LP.Backpack:FindFirstChild("Knife") ~= nil
    
    if not isMurderer then
        for v in pairs(GunCache) do
