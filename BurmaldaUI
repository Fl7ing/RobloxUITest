local RoleCache      = {}
local RoleConfidence = {}
local ROLE_COLORS    = {
    Murderer = Color3.fromRGB(255, 50,  50),
    Sheriff  = Color3.fromRGB(50,  150, 255),
    Innocent = Color3.fromRGB(80,  255, 80),
}
local confirmedMurderer = nil
local confirmedSheriff  = nil

local function DeepScanRole(plr)
    if plr == LP then return "Innocent" end
    local char = plr.Character
    if not char then return RoleCache[plr] or "Innocent" end

    for _, v in pairs(char:GetChildren()) do
        if v:IsA("Tool") then
            if v.Name == "Knife" then
                confirmedMurderer = plr
                RoleConfidence[plr] = 100
                return "Murderer"
            end
            if v.Name == "Gun" or v.Name == "Revolver" then
                confirmedSheriff = plr
                RoleConfidence[plr] = 100
                return "Sheriff"
            end
        end
    end

    SC(function()
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") then
                if v.Name == "Knife" then
                    confirmedMurderer = plr
                    RoleConfidence[plr] = 100
                    RoleCache[plr] = "Murderer"
                elseif v.Name == "Gun" or v.Name == "Revolver" then
                    confirmedSheriff = plr
                    RoleConfidence[plr] = 100
                    RoleCache[plr] = "Sheriff"
                end
            end
        end
    end)

    if RoleCache[plr] == "Murderer" or RoleCache[plr] == "Sheriff" then
        return RoleCache[plr]
    end
    if confirmedMurderer and confirmedMurderer ~= plr and confirmedSheriff and confirmedSheriff ~= plr then
        RoleConfidence[plr] = 95; return "Innocent"
    end
    if (confirmedMurderer and confirmedMurderer ~= plr) or (confirmedSheriff and confirmedSheriff ~= plr) then
        RoleConfidence[plr] = 60; return "Innocent"
    end
    RoleConfidence[plr] = 30
    return RoleCache[plr] or "Innocent"
end

local function ResetRoles()
    confirmedMurderer = nil
    confirmedSheriff  = nil
    RoleCache         = {}
    RoleConfidence    = {}
end

task.spawn(function()
