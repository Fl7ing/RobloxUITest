-- ================================================================
-- HELPERS
-- ================================================================
local function GetHRP()
    local char = LP.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char
end

local function SC(fn)
    local ok, err = pcall(fn)
    return ok, err
end

local function IsValidPos(pos)
    if typeof(pos) ~= "Vector3" then return false end
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
    if pos.X == math.huge or pos.X == -math.huge then return false end
    if pos.Y == math.huge or pos.Y == -math.huge then return false end
    if pos.Z == math.huge or pos.Z == -math.huge then return false end
    if pos.Y < -5000 or pos.Y > 50000 then return false end
    if math.abs(pos.X) > 500000 or math.abs(pos.Z) > 500000 then return false end
    return true
end

local function SafeSetCFrame(hrp, cf)
    if not hrp or not cf then return false end
    local ok = IsValidPos(cf.Position)
    if not ok then return false end
    SC(function() hrp.CFrame = cf end)
    return true
end

-- ================================================================
-- POSITION GUARD
-- Умная защита: пропускаем когда активны режимы движения
-- ================================================================
local lastValidCF   = nil
local guardDisabled = false -- внешний флаг для временного отключения

RS.Heartbeat:Connect(function()
    -- Отключаем гуард при активных движениях
    if S.Fly or S.Noclip or S.AirWalk then return end
    if guardDisabled then return end

    local hrp = GetHRP()
    if not hrp then return end

    local pos = hrp.Position
    if IsValidPos(pos) then
        lastValidCF = hrp.CFrame
    else
        if lastValidCF and IsValidPos(lastValidCF.Position) then
            SC(function()
                hrp.CFrame = lastValidCF
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end)

