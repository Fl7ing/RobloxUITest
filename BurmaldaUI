Button(PA.Utility, "TP to Gun", function()
    local hrp = GetHRP(); if not hrp then return end
    for v in pairs(GunCache) do
        if v and v.Parent and IsValidPos(v.Position) then
            SC(function() hrp.CFrame = v.CFrame + Vector3.new(0,3,0) end); break
        end
    end
end)
Button(PA.Utility, "TP to Lobby", function()
    local hrp = GetHRP(); if not hrp then return end
    local lb = WS:FindFirstChild("Lobby")
    local sp = lb and (lb:FindFirstChild("SpawnLocation") or lb:FindFirstChildWhichIsA("SpawnLocation"))
            or WS:FindFirstChildWhichIsA("SpawnLocation")
    if sp and IsValidPos(sp.Position) then
        SC(function() hrp.CFrame = sp.CFrame + Vector3.new(0,4,0) end)
    end
end)
Button(PA.Utility, "TP to Murderer", function()
    local hrp = GetHRP(); if not hrp then return end
    for _, p in pairs(PL:GetPlayers()) do
        if RoleCache[p] == "Murderer" and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and IsValidPos(r.Position) then
                SC(function() hrp.CFrame = r.CFrame + Vector3.new(0,3,0) end); break
            end
        end
    end
end)
Button(PA.Utility, "TP to Sheriff", function()
    local hrp = GetHRP(); if not hrp then return end
    for _, p in pairs(PL:GetPlayers()) do
        if RoleCache[p] == "Sheriff" and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and IsValidPos(r.Position) then
                SC(function() hrp.CFrame = r.CFrame + Vector3.new(0,3,0) end); break
            end
        end
    end
end)
