-- DODGE
-- ================================================================
local function DodgeFrom(hrp, threatPos, strength)
    if not hrp then return end
    local diff = hrp.Position - threatPos
    if diff.Magnitude == 0 then return end
    local safeStr = math.clamp(strength, 1, 200)
    SC(function()
        hrp.AssemblyLinearVelocity = diff.Unit * safeStr + Vector3.new(0, safeStr * 0.35, 0)
    end)
end

