RS.RenderStepped:Connect(function()
    local hrp = GetHRP()
    local vpX = Cam.ViewportSize.X
    local vpY = Cam.ViewportSize.Y
    local cx  = vpX / 2
    local cy  = vpY / 2

    fovCircle.Visible = S.FOVCircle
    fovCircle.Radius  = S.FOVCircleSize
    fovCircle.Position = Vector2.new(cx, cy)

    if S.Crosshair then
        local sz = S.CrosshairSize; local g = 4
        crossLines[1].Visible=true; crossLines[1].From=Vector2.new(cx-sz,cy); crossLines[1].To=Vector2.new(cx-g,cy)
        crossLines[2].Visible=true; crossLines[2].From=Vector2.new(cx+g,cy);  crossLines[2].To=Vector2.new(cx+sz,cy)
        crossLines[3].Visible=true; crossLines[3].From=Vector2.new(cx,cy-sz); crossLines[3].To=Vector2.new(cx,cy-g)
        crossLines[4].Visible=true; crossLines[4].From=Vector2.new(cx,cy+g);  crossLines[4].To=Vector2.new(cx,cy+sz)
    else
        for i = 1, 4 do crossLines[i].Visible = false end
    end

    for _, p in pairs(PL:GetPlayers()) do
        if p == LP then continue end
        if not p.Character then continue end
        local pHum  = p.Character:FindFirstChild("Humanoid")
        local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
        local pHead = p.Character:FindFirstChild("Head")
        if not pHum or not pRoot or pHum.Health <= 0 then
            local tl = tracerLines[p];   if tl then tl.Visible = false end
            local hb = healthBars[p];    if hb then hb.bg.Visible=false; hb.fill.Visible=false; hb.outline.Visible=false end
            local bx = boxESPs[p];       if bx then bx.Visible = false end
            local sk = skeletonLines[p]; if sk then for _,l in pairs(sk) do l.Visible=false end end
            continue
        end

        local rPos3d, rVis = Cam:WorldToViewportPoint(pRoot.Position)
        local hPos3d, hVis = Cam:WorldToViewportPoint(pHead and pHead.Position or pRoot.Position + Vector3.new(0,3,0))
        local role = RoleCache[p] or "Innocent"
        local col  = ROLE_COLORS[role]

        if S.Tracers and rVis then
            local tl = GetTracer(p); tl.Color = col; tl.Visible = true
            tl.From = Vector2.new(cx, vpY); tl.To = Vector2.new(rPos3d.X, rPos3d.Y)
        else
            local tl = tracerLines[p]; if tl then tl.Visible = false end
        end

        if S.BoxESP and rVis and hVis then
            local bx     = GetBox(p)
            local height = math.abs(hPos3d.Y - rPos3d.Y) * 2
            local width  = height * 0.6
            bx.Color = col; bx.Visible = true; bx.Thickness = 1.5
            bx.Size = Vector2.new(width, height)
            bx.Position = Vector2.new(rPos3d.X - width/2, rPos3d.Y - height/2)
        else
            local bx = boxESPs[p]; if bx then bx.Visible = false end
        end

        if S.HealthBar and rVis then
            local hb    = GetHealthBar(p)
            local ratio = math.clamp(pHum.Health / pHum.MaxHealth, 0, 1)
            local bH=50; local bW=4; local bX=rPos3d.X-20; local bY=rPos3d.Y-bH/2
            local hpCol = Color3.fromRGB(math.floor(255*(1-ratio)), math.floor(255*ratio), 0)
            hb.bg.Visible=true;   hb.bg.Size=Vector2.new(bW,bH);        hb.bg.Position=Vector2.new(bX,bY)
            hb.fill.Visible=true; hb.fill.Color=hpCol; hb.fill.Size=Vector2.new(bW,bH*ratio); hb.fill.Position=Vector2.new(bX,bY+bH*(1-ratio))
            hb.outline.Visible=true; hb.outline.Size=Vector2.new(bW,bH); hb.outline.Position=Vector2.new(bX,bY)
        else
            local hb = healthBars[p]
            if hb then hb.bg.Visible=false; hb.fill.Visible=false; hb.outline.Visible=false end
        end

        if S.SkeletonESP then
            local sLines = GetSkeleton(p)
            for i, bone in ipairs(SKELETON_BONES) do
                local pA = p.Character:FindFirstChild(bone[1])
                local pB = p.Character:FindFirstChild(bone[2])
                if pA and pB then
                    local posA, visA = Cam:WorldToViewportPoint(pA.Position)
                    local posB, visB = Cam:WorldToViewportPoint(pB.Position)
                    if visA and visB then
                        sLines[i].Visible = true; sLines[i].Color = col
                        sLines[i].From = Vector2.new(posA.X, posA.Y)
                        sLines[i].To   = Vector2.new(posB.X, posB.Y)
                    else sLines[i].Visible = false end
                else sLines[i].Visible = false end
            end
        else
            local sk = skeletonLines[p]
            if sk then for _, l in pairs(sk) do l.Visible = false end end
        end
    end

    if S.MurdererArrow and hrp and confirmedMurderer and confirmedMurderer.Character then
        local mRoot = confirmedMurderer.Character:FindFirstChild("HumanoidRootPart")
        if mRoot then
            local _, onScreen = Cam:WorldToViewportPoint(mRoot.Position)
            if not onScreen then
                local diff2D = Vector2.new(mRoot.Position.X - hrp.Position.X, mRoot.Position.Z - hrp.Position.Z)
                if diff2D.Magnitude > 0 then
                    local dir  = diff2D.Unit
                    local ePt  = Vector2.new(cx + dir.X*80, cy + dir.Y*80)
                    local sPt  = Vector2.new(cx + dir.X*40, cy + dir.Y*40)
                    local perp = Vector2.new(-dir.Y, dir.X) * 8
                    local back = -dir * 10
                    arrowLine.Visible=true;  arrowLine.From=sPt; arrowLine.To=ePt
                    arrowHead1.Visible=true; arrowHead1.From=ePt; arrowHead1.To=Vector2.new(ePt.X+back.X+perp.X, ePt.Y+back.Y+perp.Y)
                    arrowHead2.Visible=true; arrowHead2.From=ePt; arrowHead2.To=Vector2.new(ePt.X+back.X-perp.X, ePt.Y+back.Y-perp.Y)
                end
            else
                arrowLine.Visible=false; arrowHead1.Visible=false; arrowHead2.Visible=false
            end
        else
            arrowLine.Visible=false; arrowHead1.Visible=false; arrowHead2.Visible=false
        end
    else
        arrowLine.Visible=false; arrowHead1.Visible=false; arrowHead2.Visible=false
    end

    if S.DangerMeter and hrp then
        local cDist = math.huge
        for _, p in pairs(PL:GetPlayers()) do
            if p ~= LP and RoleCache[p] == "Murderer" and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    local d = (hrp.Position - r.Position).Magnitude
                    if d < cDist then cDist = d end
                end
            end
        end
        local danger = math.clamp(1 - (cDist/80), 0, 1)
        local mW=120; local mH=10; local mX=cx-mW/2; local mY=vpY-50
        local dCol = Color3.fromRGB(math.floor(255*danger), math.floor(255*(1-danger)), 0)
        dangerBg.Visible=true;   dangerBg.Size=Vector2.new(mW,mH);        dangerBg.Position=Vector2.new(mX,mY)
        dangerFill.Visible=true; dangerFill.Color=dCol; dangerFill.Size=Vector2.new(mW*danger,mH); dangerFill.Position=Vector2.new(mX,mY)
        dangerText.Visible=true; dangerText.Position=Vector2.new(cx,mY-16)
        dangerText.Text="DANGER: "..math.floor(danger*100).."%"; dangerText.Color=dCol
    else
        dangerBg.Visible=false; dangerFill.Visible=false; dangerText.Visible=false
    end

    if S.TargetInfo then
        local t = GetClosest(false)
        if t and t.Character and hrp then
            local r = t.Character:FindFirstChild("HumanoidRootPart")
            local h = t.Character:FindFirstChild("Humanoid")
            if r and h then
                local role2 = RoleCache[t] or "Innocent"
                local dist = math.floor((hrp.Position - r.Position).Magnitude)
                targetInfoDraw.Visible = true
                targetInfoDraw.Position = Vector2.new(cx, cy+35)
                targetInfoDraw.Text = t.Name .. "  |  " .. role2 .. "  |  " .. dist .. "m  |  HP:" .. math.floor(h.Health)
                targetInfoDraw.Color = ROLE_COLORS[role2]
            else targetInfoDraw.Visible = false end
        else targetInfoDraw.Visible = false end
    else targetInfoDraw.Visible = false end

    if S.CoinPath and hrp then
        local closest, cDist2 = nil, math.huge
        for v in pairs(CoinCache) do
            if v and v.Parent then
                local d = (v.Position - hrp.Position).Magnitude
                if d < cDist2 then closest = v; cDist2 = d end
            end
        end
        if closest then
            local p3, vis = Cam:WorldToViewportPoint(closest.Position)
            coinLine.Visible = vis
            if vis then coinLine.From = Vector2.new(cx,cy); coinLine.To = Vector2.new(p3.X,p3.Y) end
        else coinLine.Visible = false end
    else coinLine.Visible = false end
end)

