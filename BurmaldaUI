local ESPObjects = {}

local function CleanESP(p)
    local obj = ESPObjects[p]
    if not obj then return end
    SC(function() if obj.HL   then obj.HL:Destroy()   end end)
    SC(function() if obj.BB   then obj.BB:Destroy()   end end)
    SC(function() if obj.GLOW then obj.GLOW:Destroy() end end)
    ESPObjects[p] = nil
end

local function MakeESP(p)
    if not p.Character then return end
    local hum = p.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then CleanESP(p); return end
    CleanESP(p)
    local role = RoleCache[p] or "Innocent"
    local col  = ROLE_COLORS[role]
    local conf = RoleConfidence[p] or 0
    local obj  = {}

    if S.PlayerHL or S.RainbowHL then
        for _, e in pairs(p.Character:GetChildren()) do
            if e:IsA("Highlight") and e.Name == "BHL" then e:Destroy() end
        end
        SC(function()
            local hl = Instance.new("Highlight", p.Character); hl.Name = "BHL"
            hl.FillColor = col; hl.OutlineColor = col
            hl.FillTransparency = 0.55; hl.OutlineTransparency = 0
            obj.HL = hl
        end)
    end

    if S.GlowESP then
        for _, e in pairs(p.Character:GetChildren()) do
            if e:IsA("Highlight") and e.Name == "BGLOW" then e:Destroy() end
        end
        SC(function()
            local glow = Instance.new("Highlight", p.Character); glow.Name = "BGLOW"
            glow.FillColor = col; glow.OutlineColor = col
            glow.FillTransparency = 0.8; glow.OutlineTransparency = 0.3
            obj.GLOW = glow
        end)
    end

    if S.RoleESP or S.NameESP or S.DistESP or S.HealthESP or S.SpeedESP or S.WeaponESP then
        local head = p.Character:FindFirstChild("Head")
        if head then
            for _, e in pairs(head:GetChildren()) do
                if e:IsA("BillboardGui") then e:Destroy() end
            end
            SC(function()
                local myRoot   = GetHRP()
                local themRoot = p.Character:FindFirstChild("HumanoidRootPart")
                local icon     = role == "Murderer" and "🔪" or (role == "Sheriff" and "🔫" or "👤")
                local lines    = {}
                if S.RoleESP then
                    table.insert(lines, icon .. " " .. role .. (conf >= 90 and "" or (" [" .. conf .. "%]")))
                end
                if S.NameESP then table.insert(lines, p.Name) end
                if S.DistESP and myRoot and themRoot then
                    table.insert(lines, math.floor((myRoot.Position - themRoot.Position).Magnitude) .. "m")
                end
                if S.HealthESP then
                    table.insert(lines, "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
                end
                if S.SpeedESP then table.insert(lines, "SPD: " .. math.floor(hum.WalkSpeed)) end
                if S.WeaponESP then
                    local weapon = "None"
                    for _, v in pairs(p.Character:GetChildren()) do
                        if v:IsA("Tool") then weapon = v.Name; break end
                    end
                    if weapon ~= "None" then table.insert(lines, "🗡 " .. weapon) end
                end
                local bb = Instance.new("BillboardGui", head)
                bb.AlwaysOnTop = true; bb.Size = UDim2.new(0,200,0,70); bb.StudsOffset = Vector3.new(0,2.5,0)
                local tl = Instance.new("TextLabel", bb)
                tl.Size = UDim2.new(1,0,1,0); tl.BackgroundTransparency = 1
                tl.Text = table.concat(lines, "\n"); tl.TextColor3 = col
                tl.TextScaled = true; tl.Font = Enum.Font.GothamBold; tl.TextStrokeTransparency = 0.3
                obj.BB = bb
            end)
        end
    end
    ESPObjects[p] = obj
end

