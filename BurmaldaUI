-- ================================================================
-- CLOSEST PLAYER
-- ================================================================
local function GetClosest(onlyMurderer)
    local best, bestD = nil, S.SilentAimFOV
    local cx, cy = Mouse.X, Mouse.Y
    for _, p in pairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            if onlyMurderer and RoleCache[p] ~= "Murderer" then continue end
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local pos, vis = Cam:WorldToViewportPoint(hrp.Position)
                if vis then
                    local d = math.sqrt((pos.X - cx)^2 + (pos.Y - cy)^2)
                    if d < bestD then best = p; bestD = d end
                end
            end
        end
    end
    return best
end

-- ================================================================
-- RAYCAST
-- ================================================================
local function CanSee(targetHRP)
    local myHRP = GetHRP()
    if not myHRP or not targetHRP then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character}
    local result = WS:Raycast(myHRP.Position, targetHRP.Position - myHRP.Position, rp)
    if result then
        return result.Instance and result.Instance:IsDescendantOf(targetHRP.Parent)
    end
    return true
end

local function FindCoverDir(hrp, threatPos)
    local best, bestDist = nil, 0
    for angle = 0, 360, 45 do
        local rad = math.rad(angle)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        local rp  = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {LP.Character}
        local res = WS:Raycast(hrp.Position, dir * 15, rp)
        if res then
            local d = (res.Position - threatPos).Magnitude
            if d > bestDist then bestDist = d; best = dir end
        end
    end
    return best
end

